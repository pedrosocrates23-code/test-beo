---
// Elemento: "Continue lendo" (protótipo do designer — beorange-artigo_2.html, section.related).
// Sem <style>: o CSS é global, vindo de src/styles/prototype-artigo.css.
//
// Fecha o artigo com outras leituras.
//
// REGRA DO "CONTINUE LENDO" — vale para todo artigo do blog:
//
//   1. Mostra SEMPRE os dois textos mais próximos DESTE, por proximidade de vocabulário
//      (TF-IDF sobre título, subtítulos e corpo). Não é por categoria: "Gestão
//      Empresarial" cabe tanto em razão social quanto em estrutura de grupo, e foi
//      exatamente assim que o artigo sobre subsidiárias e coligadas acabou fechando com
//      "Razão Social" e "Indicadores financeiros", que não continuam o assunto.
//   2. Só entra quem passa do piso de proximidade. Abaixo dele a ligação é ruído — e
//      ruído aqui é pior que nada, porque o rodapé do artigo promete continuação.
//   3. Sem candidato acima do piso, completa com o artigo MAIS RECENTE.
//   4. Sempre exatamente DOIS. Um cartão sozinho quebra a grade de duas colunas.
//
// Quem aplica a regra é o script que monta src/data/artigos/*.json; o campo
// `relacionados` de cada artigo já chega resolvido. Este componente só desenha.
//
// O QUE O CARD PRECISA RECEBER, e por que isso não é opcional aqui:
// capa, resumo e ENDEREÇO. Até 16/09/2026 a seção subia sem os três — dois cards com o nome
// da categoria escrito no lugar da foto, um parágrafo vazio e nenhum link. Uma dobra que
// promete continuação e não leva a lugar nenhum é pior que não existir: ocupa a saída do
// artigo, que é onde o leitor decide se fica.
import ArticleCard from "./ArticleCard.astro";

interface Props {
  titulo?: string;
  /** Exatamente dois. A página de artigo garante isso a partir do campo `relacionados`. */
  artigos?: {
    categoria: string;
    titulo: string;
    resumo: string;
    meta: string;
    /** Endereço do artigo. Sem ele o card não leva a lugar nenhum — ver o cabeçalho. */
    href?: string;
    /** Capa. Sem ela o card cai no rótulo de texto do protótipo. */
    imagem?: string | null;
  }[];
}

const {
  titulo = "Continue lendo",
  artigos = [
    {
      categoria: "Reforma Tributária",
      titulo: "IBS e CBS: o que muda no aproveitamento de crédito antes da obrigatoriedade",
      resumo: "Contratos, preço e cadastros precisam estar prontos antes da transição. Veja o que revisar primeiro na sua operação.",
      meta: "Exemplo · 8 min de leitura",
    },
    {
      categoria: "Gestão financeira",
      titulo: "Conciliação na origem: por que o dado categorizado reduz retrabalho contábil",
      resumo: "Quando a movimentação nasce classificada, a contabilidade deixa de importar, conferir e reclassificar tudo de novo.",
      meta: "Exemplo · 5 min de leitura",
    },
  ],
} = Astro.props;
---
<section class="related">
  <div class="rh"><h2>{titulo}</h2></div>
  <div class="rg">
    {artigos.map((a) => (
      <ArticleCard
        thumb={a.categoria}
        imagem={a.imagem}
        cat={a.categoria}
        title={a.titulo}
        excerpt={a.resumo}
        meta={a.meta}
        href={a.href}
      />
    ))}
  </div>
</section>
