---
// Elemento: 2a dobra — faixa de marcas (Figma nó 2:1696).
// Essa dobra existe no Figma mas NÃO existia no HTML do designer, por isso faltava na home.
// Spec do nó: fundo #f4f1ef, radius 26.25px, padding 45.36 / 64.8, gap 45.36, título 35px
// ("+ XX empresas" SemiBold + "já contam com" Light), logos em caixas de 198x63 com opacity .8.
//
// Duas camadas de animação, ambas só com transform (sem JS novo, sem biblioteca):
//  - marquee em loop contínuo das marcas
//  - contador que sobe de 0 até o número quando a seção entra na tela, aproveitando o
//    IntersectionObserver que o protótipo já tem para o .rv
export interface Props {
  /** Número de empresas. O Figma deixou "XX" sem preencher; o nó mobile (48:74) diz 40. */
  total?: number;
}
const { total = 40 } = Astro.props;

const marcas = [
  { arquivo: "escavador", nome: "Escavador", w: 198, h: 40 },
  { arquivo: "ventiur", nome: "Ventiur Aceleradora", w: 123, h: 33 },
  { arquivo: "omie", nome: "Omie", w: 124, h: 40 },
  { arquivo: "kamino", nome: "Kamino", w: 168, h: 30 },
];
// O loop só emenda sem salto se cada grupo for pelo menos tão largo quanto a tela — por isso
// a repetição é CALCULADA, não fixa: ao acrescentar marcas aqui, ela se ajusta sozinha
// (com 4 marcas dá 3 repetições; passando de ~9 marcas, 1 já basta e nada é desperdiçado).
const LARGURA_ITEM = 198 + 40; // caixa da marca + gap
const LARGURA_ALVO = 2250; // maior largura que a foto do hero cobre; serve de teto de tela
const repeticoes = Math.max(1, Math.ceil(LARGURA_ALVO / (marcas.length * LARGURA_ITEM)));
const grupo = Array.from({ length: repeticoes }, () => marcas).flat();
---
<section class="marcas rv" aria-labelledby="marcas-titulo">
  <h2 id="marcas-titulo" class="marcas-titulo">
    <b>+&nbsp;<span class="odo" style={`--alvo:${total}`} role="img" aria-label={`mais de ${total}`}></span>&nbsp;empresas</b> <span class="marcas-leve">já contam com</span>
  </h2>

  <div class="marcas-esteira">
    <div class="marcas-trilho" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="marcas-grupo">
          {grupo.map((m) => (
            <span class="marcas-item">
              <img src={`/img/marcas/${m.arquivo}.webp`} alt="" width={m.w} height={m.h} loading="lazy" decoding="async" />
            </span>
          ))}
        </div>
      ))}
    </div>
    <ul class="marcas-sr">
      {marcas.map((m) => <li>{m.nome}</li>)}
    </ul>
  </div>
</section>

<style>
  /* Estilo da faixa, que até 16/09/2026 morava em prototype-home.css. Veio para cá quando a
     peça passou a ser usada também em /cases/, que carrega outra folha de protótipo.
     Scoped: o Astro carimba os elementos do markup deste arquivo, e todos os seletores daqui
     falam de elementos que estão logo acima. A classe .in é acrescentada em tempo de execução
     ao .marcas pelo observador do protótipo — mas o .marcas já veio carimbado do markup,
     então a regra .marcas.in .odo continua valendo.
     Uma regra de fora ainda alcança esta peça de propósito: `.marcas-esteira{overflow:hidden}`
     em mobile.css, que impede o trilho de 4.272px de esticar a página. */
  /* ---------- 2a DOBRA — FAIXA DE MARCAS (Figma no 2:1696) ----------
   Animacoes so com transform/opacity: nao disparam layout nem paint, rodam no compositor.
   Nenhuma biblioteca: um marquee em CSS puro custa ~0 e um carousel de React custaria
   o runtime inteiro do framework nesta pagina, que hoje e 100% estatica. */
/* A faixa colorida acompanha a largura da pagina (no Figma o no 2:1696 tem 1440px, que e a
   prancheta inteira — ou seja, full-bleed). O conteudo de dentro e que respeita o container. */
.marcas{background:#f4f1ef;padding:45.36px 0 64.8px;width:100%;
  display:flex;flex-direction:column;align-items:center;gap:45.36px;overflow:hidden}
.marcas-titulo{font-size:clamp(24px,2.9vw,35px);line-height:39.2px;letter-spacing:-.7px;color:var(--ink);
  text-align:center;font-weight:300;margin:0;width:100%;max-width:var(--max);padding:0 28px}
.marcas-titulo b{font-weight:600}
.marcas-leve{font-weight:300}

/* contador que SOBE ate o alvo. @property permite animar um inteiro de verdade, e counter()
   imprime o valor — e o unico jeito de fazer o numero subir sem JavaScript.
   initial-value ja e o valor final: navegador sem suporte a @property mostra 40 parado em
   vez de zero. min-width em ch + tabular-nums evitam o titulo pular quando vai de 1 para
   2 digitos. */
@property --num{syntax:"<integer>";initial-value:40;inherits:false}
.odo{display:inline-block;min-width:2ch;text-align:center;font-variant-numeric:tabular-nums;counter-reset:num var(--num)}
.odo::after{content:counter(num)}
.marcas.in .odo{animation:marcas-conta 1.1s cubic-bezier(.16,.84,.3,1) forwards}
@keyframes marcas-conta{from{--num:0}to{--num:var(--alvo,40)}}

/* marquee: o trilho tem 2 grupos identicos e anda exatamente -50%, entao a emenda e invisivel */
.marcas-esteira{width:100%;position:relative;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.marcas-trilho{display:flex;width:max-content;will-change:transform;animation:marcas-anda 38s linear infinite}
.marcas-esteira:hover .marcas-trilho{animation-play-state:paused}
.marcas-grupo{display:flex;align-items:center;gap:40px;padding-right:40px}
.marcas-item{display:flex;align-items:center;justify-content:center;width:198px;height:63px;flex:none;opacity:.8}
.marcas-item img{max-width:100%;height:auto;width:auto}
@keyframes marcas-anda{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}

.marcas-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}

/* quem pediu menos movimento recebe a faixa parada e o numero ja no valor final */
@media(prefers-reduced-motion:reduce){
  .marcas-trilho{animation:none;transform:none}
  .marcas-grupo:nth-child(2){display:none}
  .marcas-grupo{justify-content:center;width:100%;flex-wrap:wrap}
  .marcas.in .odo{animation:none}
}
@media(max-width:680px){
  .marcas{padding:32px 0 40px;gap:28px}
  .marcas-item{width:150px;height:52px}
  .marcas-grupo{gap:28px;padding-right:28px}
}
</style>
