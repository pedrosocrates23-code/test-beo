---
// Elemento: Cabeçalho do artigo (protótipo do designer — beorange-artigo_2.html, div.art-wrap).
// Sem <style>: o CSS é global, vindo de src/styles/prototype-artigo.css.
//
// A .art-meta saiu de dentro da .art-wrap e virou irmã dela, dentro da própria
// .art-meta-wrap — que repete a medida da .art-wrap (800px, padding 28) para o desktop ficar
// pixel a pixel como antes. O motivo é o mobile: lá a faixa precisa aparecer DEPOIS da imagem
// de destaque, e 'order' só reordena filhos diretos do mesmo container flex. Enquanto estava
// aninhada na .art-wrap, era impossível movê-la em relação à .feature sem duplicar markup.
import { formatarData } from "../../lib/artigo";

interface Props {
  titulo: string;
  lead: string;
  /** Data de publicação em AAAA-MM-DD. Vira "16 de junho de 2026" na faixa. */
  dataIso: string;
  categoria: string;
  /** Minutos de leitura — calcule com tempoDeLeitura() em vez de digitar à mão. */
  minutos: number;
  autor?: string;
  autorCargo?: string;
  /** Entity home de quem assina. Com ela o byline vira link; sem ela, continua texto.
   *  O link existe por dois motivos que andam juntos: o leitor consegue conferir quem
   *  escreveu, e o `author` do JSON-LD deixa de ser uma afirmação que a página não sustenta,
   *  porque o caminho até a pessoa está ali, visível, na mesma tela. */
  autorHref?: string;
  /** Recorte quadrado do rosto de quem assina. Sem ele, fica o desenho genérico do protótipo.
   *  Rosto de verdade no byline é o que separa "assinado por alguém" de "assinado por uma
   *  pessoa", e é o par visível do `image` do Person no JSON-LD. */
  autorFoto?: string;
  /** Faixa de aviso de rascunho. Omita numa publicação real. */
  aviso?: string;
}

const {
  titulo,
  lead,
  dataIso,
  categoria,
  minutos,
  autor = "Time Tributário Beorange",
  autorCargo = "Especialistas em Lucro Real",
  autorHref,
  autorFoto,
  aviso,
} = Astro.props;
---
<div class="art-meta-wrap">
  <div class="art-meta">
    <div class="m">
      <div class="l">Data</div>
      <div class="v"><time datetime={dataIso}>{formatarData(dataIso)}</time></div>
    </div>
    <div class="m">
      <div class="l">Categoria</div>
      <div class="v">{categoria}</div>
    </div>
    <div class="m">
      <div class="l">Tempo de leitura</div>
      <div class="v">{minutos} min</div>
    </div>
  </div>
</div>
<div class="art-wrap">
  <h1 class="art-h1">{titulo}</h1>
  {lead && <p class="art-lead">{lead}</p>}
  <div class="byline">
    <span class="av">
      {autorFoto
        ? <img class="av-foto" src={autorFoto} alt="" width="48" height="48" loading="lazy" decoding="async" />
        : <svg viewBox="0 0 100 100" aria-hidden="true"><path d="M57.3 8.6 A42 42 0 1 1 42.7 8.6" fill="none" stroke="#FF6A14" stroke-width="14"/></svg>}
    </span>
    <div>
      <div class="bn">
        {autorHref ? <a class="bn-link" href={autorHref} rel="author">{autor}</a> : autor}
      </div>
      <div class="bs">{autorCargo}</div>
    </div>
  </div>
  {aviso && <div class="ex-ribbon">{aviso}</div>}
</div>

<style>
  /* O nome do autor vira link sem perder o desenho do byline: mesma cor, mesmo peso, e o
     sublinhado só no hover e no foco. Um link azul de navegador no meio da assinatura
     chamaria mais atenção que o título do artigo. */
  .bn-link{color:inherit;text-decoration:none}
  /* A foto ocupa o mesmo espaço do desenho que ela substitui, então a faixa do byline não
     muda de altura nos artigos com foto e sem foto. */
  .av-foto{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block}
  .bn-link:hover,.bn-link:focus-visible{text-decoration:underline}
</style>
