---
// Elemento: Barra de compartilhamento do artigo (protótipo do designer — beorange-artigo_2.html).
// Sem <style>: o CSS é global, vindo de src/styles/prototype-artigo.css.
//
// Os SVGs seguem inline e NÃO foram para o catálogo do Icone.astro de propósito: são
// logotipos de terceiros, path preenchido, e não peças do desenho da Beorange — não devem
// herdar traço nem cor do sistema, nem ser "ajustados" junto com os ícones da casa.
//
// Os links nascem "#", como no protótipo. Passando `url` e `titulo`, viram endereços reais de
// compartilhamento; o "copiar link" continua inerte até existir o script que o atenda.
interface Props {
  rotulo?: string;
  /** URL absoluta do artigo. Sem ela os links ficam em "#", como no protótipo. */
  url?: string;
  /** Título do artigo, usado no texto do compartilhamento. */
  titulo?: string;
}

const { rotulo = "Compartilhar", url, titulo = "" } = Astro.props;

const u = url ? encodeURIComponent(url) : "";
const t = encodeURIComponent(titulo);
const destino = {
  // O Instagram não tem endpoint de compartilhamento na web: link direto para o perfil seria
  // enganoso, então ele fica inerte mesmo quando os outros funcionam.
  instagram: "#",
  x: url ? `https://twitter.com/intent/tweet?url=${u}&text=${t}` : "#",
  linkedin: url ? `https://www.linkedin.com/sharing/share-offsite/?url=${u}` : "#",
  copiar: "#",
};
---
<aside class="share" aria-label="Compartilhar">
  <span class="sl">{rotulo}</span>
  <a href={destino.instagram} aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2m0 5.6A4.2 4.2 0 1016.2 12 4.2 4.2 0 0012 7.8m0 6.9A2.7 2.7 0 1114.7 12 2.7 2.7 0 0112 14.7m5.3-7.1a1 1 0 10-1-1 1 1 0 001 1"/></svg></a>
  <a href={destino.x} aria-label="X"><svg viewBox="0 0 24 24"><path d="M17.5 3h3l-6.6 7.6L21.7 21h-5.9l-4.2-5.5L6.7 21H3.6l7.1-8.1L2.7 3h6l3.8 5 4.9-5z"/></svg></a>
  <a href={destino.linkedin} aria-label="LinkedIn"><svg viewBox="0 0 24 24"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5M3 8.98h4V21H3zM9 8.98h3.8v1.64h.05c.53-1 1.83-2.05 3.76-2.05 4 0 4.74 2.64 4.74 6.07V21H17V15.3c0-1.36-.02-3.1-1.9-3.1s-2.18 1.47-2.18 3v5.8H9z"/></svg></a>
  <a href={destino.copiar} aria-label="Copiar link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1"/><path d="M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1"/></svg></a>
</aside>
