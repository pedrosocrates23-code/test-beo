---
// Elemento: Footer.
// Fonte da verdade: HTML oficial do designer (beorange-homepage_2.html, linhas 689-752).
// Dados de contato marcados como ILUSTRATIVOS pelo próprio designer — preservados como estão.
// ATENÇÃO: este componente também é usado por /contabilidade e /blog/exemplo. O CSS que o
// estiliza é global (prototype-*.css), importado pela página que o renderiza.
// Único ponto variável entre páginas: a home aponta o logo para "#top", as demais para "/".
export interface Props {
  logoHref?: string;
  endereco?: string;
  telefone?: string;
  telefoneLink?: string;
  email?: string;
  horario?: string;
  /** CNPJ na linha final. Enquanto não vier o número real, fica de fora — CNPJ inventado
   *  numa linha de copyright é informação cadastral falsa, não placeholder inofensivo. */
  cnpj?: string;
  /** Perfis oficiais. Uma rede sem URL não entra: ícone de rede social apontando para "#"
   *  promete um perfil que não existe e derruba a confiança no rodapé inteiro. */
  redes?: { nome: string; url: string; path: string }[];
  /** Aviso do que ainda falta. Passe "" quando não faltar mais nada. */
  pendencia?: string;
}

// Marcas de terceiros, não ícones da casa: por isso ficam aqui e não no catálogo do
// Icone.astro — são path preenchido, não traço, e não devem herdar cor nem espessura
// do design system da Beorange.
const LOGO_INSTAGRAM = "M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2m0 5.6A4.2 4.2 0 1016.2 12 4.2 4.2 0 0012 7.8m0 6.9A2.7 2.7 0 1114.7 12 2.7 2.7 0 0112 14.7m5.3-7.1a1 1 0 10-1-1 1 1 0 001 1";
const LOGO_LINKEDIN = "M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5M3 8.98h4V21H3zM9 8.98h3.8v1.64h.05c.53-1 1.83-2.05 3.76-2.05 4 0 4.74 2.64 4.74 6.07V21H17V15.3c0-1.36-.02-3.1-1.9-3.1s-2.18 1.47-2.18 3v5.8H9z";
const LOGO_FACEBOOK = "M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0022 12";

// Dados reais fornecidos pelo cliente em 15/09/2026. O WhatsApp (41 99693-0218) é outro
// número e vive na página de contato — não é o telefone abaixo.
const {
  logoHref = "/",
  endereco = "Av. Visc. de Guarapuava, 3263 · Centro · Curitiba/PR · 80010-100",
  telefone = "+55 41 9644-0060",
  telefoneLink = "tel:+554196440060",
  email = "contato@beorange.app",
  horario = "Segunda a sexta, em horário comercial",
  cnpj,
  // Perfis oficiais confirmados pelo cliente em 15/09/2026. O YouTube saiu: o rodapé tinha o
  // ícone apontando para "#" e nenhum canal foi informado. Se existir, é só acrescentar aqui.
  redes = [
    { nome: "Instagram", url: "https://www.instagram.com/beorangeapp/", path: LOGO_INSTAGRAM },
    { nome: "LinkedIn", url: "https://www.linkedin.com/company/beorangeapp/", path: LOGO_LINKEDIN },
    { nome: "Facebook", url: "https://www.facebook.com/beorangeapp/", path: LOGO_FACEBOOK },
  ],
  pendencia = "Faltam o horário exato de atendimento e o CNPJ.",
} = Astro.props;
const ano = new Date().getFullYear();
---
<footer class="site">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href={logoHref} class="logo"><img class="logo-img logo-img--light" src="/img/logo.webp" alt="Beorange" width="218" height="48" /></a>
        <p>Contabilidade, operação financeira e tecnologia para empresas em crescimento.</p>
        <div class="socials">
          {redes.map((r) => (
            <a href={r.url} aria-label={r.nome} rel="noopener noreferrer" target="_blank"><svg viewBox="0 0 24 24"><path d={r.path}/></svg></a>
          ))}
        </div>
      </div>
      <div class="foot-col">
        <h4>Contabilidade Beorange</h4>
        <ul>
          <li><a href="/contabilidade-beorange/contabil/">Contábil</a></li>
          <li><a href="/contabilidade-beorange/fiscal/">Fiscal</a></li>
          <li><a href="/contabilidade-beorange/departamento-pessoal/">Departamento Pessoal</a></li>
          <li><a href="/contabilidade-beorange/tributario/">Tributário</a></li>
          <li><a href="/contabilidade-beorange/societario/">Societário</a></li>
          <li><a href="/contabilidade-beorange/assessoria/">Assessoria e Consultoria</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Conta Beorange</h4>
        <ul>
          <li><a href="/conta-beorange/conta-pj/">Conta PJ e movimentação</a></li>
          <li><a href="/conta-beorange/cobrancas/">Cobranças e recebimentos</a></li>
          <li><a href="/conta-beorange/portal/">Portal de gestão financeira</a></li>
          <li><a href="/conta-beorange/bpo-financeiro/">BPO Financeiro</a></li>
          <li><a href="/conta-beorange/bora-financeira/">Bora Financeira</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Beorange</h4>
        <ul>
          <li><a href="/sobre-nos/">Sobre nós</a></li>
          <li><a href="/cases/">Cases</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/imprensa/">Imprensa</a></li>
          <li><a href="/contato/">Contato</a></li>
          <li><a href="/trabalhe-conosco/">Trabalhe conosco</a></li>
        </ul>
      </div>
      <div class="foot-col foot-contact">
        <h4>Contato</h4>
        <p>{endereco}</p>
        <p><a href={telefoneLink}>{telefone}</a></p>
        <p><a href={`mailto:${email}`}>{email}</a></p>
        <p>{horario}</p>
        {pendencia && <div class="foot-pending">{pendencia}</div>}
      </div>
    </div>
    <div class="foot-bottom">
      <span class="copy">© {ano} Beorange{cnpj ? ` · CNPJ ${cnpj}` : ""} · Todos os direitos reservados.</span>
      <div class="legal">
        <a href="/politica-de-cookies/">Política de Cookies</a>
        <a href="/politica-de-privacidade/">Política de Privacidade</a>
        <a href="/lgpd/">LGPD</a>
        <a href="/termos-de-uso/">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>
