---
// Elemento: Badge/Default (Figma node 21:124)
export interface Props {
  label?: string;
  class?: string;
}
const { label = "Tag", class: className = "" } = Astro.props;
---
<span class={`badge-default ${className}`}>
  {label}
</span>

<style>
  .badge-default {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-brand-subtle);
    color: var(--text-brand);
    border-radius: var(--radius-full);
    padding: var(--space-4) var(--space-12);
    font: 500 12px/normal var(--font-family-base);
  }
</style>
