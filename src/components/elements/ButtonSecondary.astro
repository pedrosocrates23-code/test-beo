---
// Elemento: Button/Secondary (Figma node 21:101)
export interface Props {
  label?: string;
  href?: string;
  class?: string;
}
const { label = "Secondary", href, class: className = "" } = Astro.props;
const Tag = href ? "a" : "button";
---
<Tag href={href} class={`btn-secondary ${className}`}>
  {label}
</Tag>

<style>
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--action-secondary);
    color: var(--text-inverse);
    border: none;
    border-radius: var(--radius-full);
    padding: var(--space-12) var(--space-24);
    font: 600 14px/normal var(--font-family-base);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .btn-secondary:hover {
    background: var(--action-secondary-hover);
  }
</style>
