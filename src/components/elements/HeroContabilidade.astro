---
// Elemento: Dobra 1 da página Contabilidade — hero centralizado com foto full-bleed.
// Fonte da verdade: Figma nó 47:936, onde a foto do nó 71:2194 ("image 8") é filha direta da
// seção e cobre a dobra inteira. O protótipo do designer (beorange-contabilidade_1.html)
// trazia a foto dentro de um card .hero-media de 900px com o selo "Leitura dos números" —
// nenhum dos dois existe no Figma, então saíram.
// A foto entra pela variável --hero-photo em src/styles/prototype-contabilidade.css.
//
// Diferente do HeroSection da home, este é centralizado e sem selos. Use em páginas de
// serviço; para trocar a foto, sobrescreva --hero-photo no CSS da página.
import Icone from "./Icone.astro";

interface Props {
  /** `null` remove a etiqueta. `undefined` mantém o padrão da Contabilidade. */
  eyebrow?: string | null;
  titulo?: string;
  lead?: string;
  /** `null` remove o botão. A distinção importa: `undefined` cai no valor padrão, `null`
   *  diz explicitamente "esta página não tem CTA aqui" — é o caso da /cases/, cujo hero é
   *  só título e lead. */
  ctaPrimario?: { texto: string; href: string } | null;
  ctaSecundario?: { texto: string; href: string } | null;
  /** Foto de fundo desta página, a partir de public/. Sem isto vale a foto padrão, definida
   *  em --hero-photo no prototype-contabilidade.css. */
  foto?: string;
  /** Faixa de uma linha abaixo dos botões. Na Conta Beorange carrega o modelo de cobrança,
   *  que o documento manda expor já na primeira dobra por ser argumento comercial. */
  destaque?: string;
  /** Variante com texto à ESQUERDA e foto como <img> (com alt e title) em vez de background.
   *  Para quando a foto tem uma pessoa e o Figma pede o texto ao lado dela, não por cima.
   *  Substitui `foto`: use um ou outro. */
  fotoImg?: { src: string; srcset?: string; alt: string; title?: string; width: number; height: number };
}

const {
  eyebrow = "Contabilidade Beorange",
  titulo = "Contabilidade para quem precisa de mais do que guias e obrigações",
  lead = "Execução técnica, tecnologia e acompanhamento consultivo em uma estrutura só. Para empresas em crescimento que precisam de números confiáveis, visão integrada e clareza para decidir.",
  ctaPrimario = { texto: "Solicitar diagnóstico", href: "#diagnostico" },
  ctaSecundario = { texto: "Ver as seis frentes", href: "#frentes" },
  destaque,
  foto,
  fotoImg,
} = Astro.props;
---
<section
  class:list={["hero", { "hero--esq": !!fotoImg }]}
  style={fotoImg ? `--hero-photo:none;--hero-ratio:${fotoImg.width}/${fotoImg.height}` : foto ? `--hero-photo:url('${foto}')` : undefined}
>
  {fotoImg && (
    /* Carrega já: é a imagem da primeira dobra (LCP), por isso eager + fetchpriority. */
    <img
      class="hero__foto"
      src={fotoImg.src}
      srcset={fotoImg.srcset}
      sizes="100vw"
      alt={fotoImg.alt}
      title={fotoImg.title}
      width={fotoImg.width}
      height={fotoImg.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  )}
  <div class="wrap">
    <div class="hero-inner rv in">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{titulo}</h1>
      <p class="lead">{lead}</p>
      {(ctaPrimario || ctaSecundario) && (
        <div class="hero-cta">
          {ctaPrimario && <a href={ctaPrimario.href} class="btn btn-primary">{ctaPrimario.texto}</a>}
          {ctaSecundario && <a href={ctaSecundario.href} class="btn btn-ghost">{ctaSecundario.texto}</a>}
        </div>
      )}
      {destaque && <p class="hero-destaque">{destaque}</p>}
    </div>
  </div>
</section>
