---
// Elemento: Button/Primary (Figma node 21:98)
export interface Props {
  label?: string;
  href?: string;
  class?: string;
}
const { label = "Primary", href, class: className = "" } = Astro.props;
const Tag = href ? "a" : "button";
---
<Tag href={href} class={`btn-primary ${className}`}>
  {label}
</Tag>

<style>
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--action-primary);
    color: var(--text-inverse);
    border: none;
    border-radius: var(--radius-full);
    padding: var(--space-12) var(--space-24);
    font: 600 14px/normal var(--font-family-base);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .btn-primary:hover {
    background: var(--action-primary-hover);
  }
  .btn-primary:active {
    background: var(--action-primary-active);
  }
</style>
