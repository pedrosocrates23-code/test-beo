---
// Elemento: depoimentos de clientes, com foto, atribuição e a frase literal.
//
// PROCEDÊNCIA DO TEXTO — leia antes de editar qualquer frase daqui.
// Os cinco depoimentos não foram escritos: foram extraídos do HTML que https://beorange.app/
// servia em 16/09/2026, o site que ainda está no ar. Nada foi reescrito, resumido nem
// "melhorado". O Framer quebra cada frase em vários nós por causa dos trechos em negrito, e a
// remontagem foi conferida trecho a trecho contra o arquivo servido — as 152 palavras das
// cinco frases existem, literalmente, na fonte.
//
// Por isso: se precisar mexer no texto, volte à fonte. Depoimento é declaração de terceiro;
// editar por estilo transforma citação em paráfrase assinada por outra pessoa.
//
// O QUE AINDA FALTA, e não depende de código:
//   - autorização POR ESCRITO de cada um para uso de nome, cargo, marca e resultado. As
//     frases já estão públicas no site atual da Beorange, mas o documento de tom exige
//     autorização documentada, e é ela que sustenta o uso se alguém pedir para sair;
//   - o período de apuração de cada número citado ("meio milhão por ano", "R$ 400 mil",
//     "300 mil reais"). Depoimento não é case: aqui o número é fala do cliente, não medição
//     apresentada pela Beorange. É essa a diferença que o subtítulo desta seção marca.
//
// As fotos vieram do mesmo lugar e estão em public/img/cases/, em WebP de 240px. Não são
// hotlink do CDN do Framer de propósito: quando o site antigo sair do ar, a foto sairia junto.
import type { HTMLAttributes } from "astro/types";

export interface Depoimento {
  nome: string;
  cargo: string;
  empresa: string;
  /** A frase, literal, sem aspas: elas entram na marcação, como <q>. */
  texto: string;
  foto?: string;
  /** Inverte o cartão para a cor da marca. Usado para dar ritmo à grade, um por linha. */
  destaque?: boolean;
}

interface Props {
  id?: string;
  eyebrow?: string;
  titulo?: string;
  texto?: string;
  depoimentos?: Depoimento[];
  /** "clara" (padrão) ou "alternada" (fundo bege). */
  variante?: "clara" | "alternada";
}

const PADRAO: Depoimento[] = [
  {
    nome: "Jorge Abussamra",
    cargo: "COO",
    empresa: "Zeta Dados",
    foto: "/img/cases/jorge-abussamra.webp",
    texto:
      "A Beorange tem sido ótima e sempre com atenção. O time puxou uma revisão tributária, comparou faturamento e alíquotas e, juntos, vimos que migrar para o Lucro Real pode gerar economia de quase meio milhão por ano.",
  },
  {
    nome: "Marivaldo Júnior",
    cargo: "CoFounder",
    empresa: "Escavador",
    foto: "/img/cases/marivaldo-junior.webp",
    destaque: true,
    texto:
      "Gostamos da Beorange pelo atendimento próximo e consultivo. Na transição do Simples, reduziram PIS/Cofins e impostos, gerando quase R$ 400 mil de economia para reinvestir no crescimento.",
  },
  {
    nome: "Rafael Rodeiro",
    cargo: "Founder",
    empresa: "Ribon App",
    foto: "/img/cases/rafael-rodeiro.webp",
    texto:
      "Gostamos da Beorange pelo contato próximo, mas também por, surpreendentemente, eles terem encontrado furos na contabilidade anterior que geraram uma economia de 300 mil reais, além de abaixarem nossos impostos.",
  },
  {
    nome: "Higino Mandaji",
    cargo: "Founder",
    empresa: "B2Bhotel",
    foto: "/img/cases/higino-mandaji.webp",
    texto:
      "A Beorange transformou nossa gestão contábil: reduziu impostos, organizou as finanças e nos deu a segurança necessária para tomar decisões estratégicas e impulsionar o crescimento da empresa",
  },
  {
    nome: "Laura Mitterer",
    cargo: "Founder",
    empresa: "Agada Digital",
    foto: "/img/cases/laura-mitterer.webp",
    destaque: true,
    texto:
      "Nunca encontrei nada igual no mercado: contábil, tributário e financeiro tudo integrado. Obrigações em dia, impostos sob controle, tranquilidade garantida e uma empresa de total confiança. Não tem como não gostar",
  },
];

const {
  id,
  eyebrow,
  titulo = "O que os clientes dizem",
  texto,
  depoimentos = PADRAO,
  variante = "clara",
} = Astro.props as Props;
---
<section class={`depo${variante === "alternada" ? " alt" : ""}`} id={id}>
  <div class="wrap">
    <div class="sec-head rv">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{titulo}</h2>
      {texto && <p>{texto}</p>}
    </div>

    <div class="depo-carrossel" data-depo-carrossel>
      <ul class="depo-trilha">
      {depoimentos.map((d, i) => (
        <li
          class={`depo-card${d.destaque ? " depo-card--marca" : ""}`}
          aria-roledescription="depoimento"
          aria-label={`${i + 1} de ${depoimentos.length}`}
        >
          {d.foto && (
            <img
              class="depo-foto"
              src={d.foto}
              alt={`${d.nome}, ${d.cargo} da ${d.empresa}`}
              width="88"
              height="88"
              loading={i < 3 ? "eager" : "lazy"}
              decoding="async"
            />
          )}
          {/* As cinco estrelas reproduzem o que a fonte exibe para cada um destes
              depoimentos. aria-hidden porque a informação já está no texto: uma leitura
              "estrela estrela estrela..." não acrescenta nada a quem ouve a página. */}
          <span class="depo-estrelas" aria-hidden="true">★★★★★</span>
          <p class="depo-nome">{d.nome}</p>
          <p class="depo-cargo">{d.cargo} da <strong>{d.empresa}</strong></p>
          <blockquote class="depo-frase"><q>{d.texto}</q></blockquote>
        </li>
      ))}
      </ul>

      {/* Botões nas laterais, escondidos por padrão e revelados pelo JS: sem script eles não
          fariam nada, e botão morto é pior que botão ausente. Sem JS o carrossel continua
          utilizável — a trilha é uma área de rolagem de verdade, que arrasta no celular e
          rola com as setas do teclado no computador. */}
      <button type="button" class="depo-nav depo-nav--ant" data-depo-ant
              aria-label="Depoimento anterior" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none"
             stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>
      <button type="button" class="depo-nav depo-nav--prox" data-depo-prox
              aria-label="Próximo depoimento" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none"
             stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 6l6 6-6 6" />
        </svg>
      </button>

      {/* A contagem sai do desenho mas continua existindo para quem ouve a página: sem ela,
          avançar o carrossel com o leitor de tela não anuncia nada. */}
      <p class="depo-status" role="status" aria-live="polite">
        Depoimento 1 de {depoimentos.length}
      </p>
    </div>
  </div>
</section>

<script>
  // Carrossel de depoimentos: laço infinito, botões nas laterais e arrasto com o mouse.
  //
  // A rolagem continua sendo a do navegador — overflow-x com scroll-snap. O script
  // acrescenta três coisas que o CSS não faz: o laço, o arrasto com mouse e o anúncio
  // para leitor de tela.
  //
  // COMO O LAÇO FUNCIONA, e por que os clones nascem aqui e não no HTML.
  // A trilha vira [clones do fim][originais][clones do início]. Quando a rolagem entra na
  // faixa dos clones, o script devolve a posição para o bloco original — sem animação e
  // sem snap, num piscar que o olho não pega, porque o conteúdo nos dois pontos é
  // idêntico. Os clones são criados por JS de propósito: no HTML servido eles seriam
  // texto repetido, que o buscador leria como conteúdo duplicado e o leitor de tela
  // anunciaria três vezes. Por isso também levam aria-hidden e ficam fora da ordem de
  // tabulação.
  document.querySelectorAll<HTMLElement>("[data-depo-carrossel]").forEach((raiz) => {
    const trilha = raiz.querySelector<HTMLElement>(".depo-trilha");
    const ant = raiz.querySelector<HTMLButtonElement>("[data-depo-ant]");
    const prox = raiz.querySelector<HTMLButtonElement>("[data-depo-prox]");
    const status = raiz.querySelector<HTMLElement>(".depo-status");
    if (!trilha || !ant || !prox || !status) return;

    const originais = Array.from(trilha.querySelectorAll<HTMLElement>(".depo-card"));
    const total = originais.length;
    if (total < 2) return;

    ant.hidden = false;
    prox.hidden = false;

    // ---- clones ----
    const clonar = (fonte: HTMLElement[], ondePor: "antes" | "depois") => {
      const frag = document.createDocumentFragment();
      for (const c of fonte) {
        const copia = c.cloneNode(true) as HTMLElement;
        copia.setAttribute("aria-hidden", "true");
        copia.dataset.clone = "1";
        copia.querySelectorAll("a, button").forEach((e) => e.setAttribute("tabindex", "-1"));
        frag.appendChild(copia);
      }
      if (ondePor === "antes") trilha.insertBefore(frag, trilha.firstChild);
      else trilha.appendChild(frag);
    };
    clonar(originais, "depois");
    clonar(originais, "antes");

    const todos = () => Array.from(trilha.querySelectorAll<HTMLElement>(".depo-card"));
    const esq = (el: HTMLElement) => el.offsetLeft - trilha.offsetLeft;

    const suave = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";

    /** Põe a rolagem no primeiro card original, sem animação. */
    const ancorar = () => {
      trilha.style.scrollSnapType = "none";
      trilha.scrollLeft = esq(todos()[total]);
      trilha.style.scrollSnapType = "";
    };

    // Espera o layout assentar antes de medir: fonte e imagem mudam a largura do cartão.
    requestAnimationFrame(ancorar);
    window.addEventListener("load", ancorar, { once: true });

    /** Índice do card mais próximo da borda esquerda da área visível. */
    const indiceAtual = () => {
      const x = trilha.scrollLeft;
      const lista = todos();
      let melhor = 0;
      let menor = Infinity;
      lista.forEach((c, i) => {
        const d = Math.abs(esq(c) - x);
        if (d < menor) {
          menor = d;
          melhor = i;
        }
      });
      return melhor;
    };

    const irPara = (i: number) => {
      const lista = todos();
      const alvo = lista[Math.max(0, Math.min(lista.length - 1, i))];
      trilha.scrollTo({ left: esq(alvo), behavior: suave() });
    };

    ant.addEventListener("click", () => irPara(indiceAtual() - 1));
    prox.addEventListener("click", () => irPara(indiceAtual() + 1));

    // ---- recentragem e anúncio ----
    let pendente = 0;
    const aoParar = () => {
      const lista = todos();
      const i = indiceAtual();
      // fora do bloco do meio: devolve para a posição equivalente, sem animação
      if (i < total || i >= total * 2) {
        const equivalente = ((i % total) + total) % total;
        trilha.style.scrollSnapType = "none";
        trilha.scrollLeft = esq(lista[total + equivalente]);
        trilha.style.scrollSnapType = "";
      }
      const visivel = (((indiceAtual() % total) + total) % total) + 1;
      status.textContent = `Depoimento ${visivel} de ${total}`;
    };
    trilha.addEventListener(
      "scroll",
      () => {
        window.clearTimeout(pendente);
        pendente = window.setTimeout(aoParar, 140);
      },
      { passive: true },
    );
    window.addEventListener("resize", ancorar, { passive: true });

    // ---- arrastar com o mouse ----
    // O toque já arrasta sozinho: quem não arrasta é o ponteiro de mouse, e é só para ele
    // que este trecho existe. Um arrasto curto é clique, e precisa continuar clicando o
    // link de dentro do cartão; por isso o bloqueio de clique só entra depois de 6px.
    const LIMIAR = 6;
    let arrastando = false;
    let partiuEm = 0;
    let rolagemInicial = 0;
    let andou = 0;

    trilha.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      arrastando = true;
      andou = 0;
      partiuEm = e.clientX;
      rolagemInicial = trilha.scrollLeft;
      trilha.style.scrollSnapType = "none";
      trilha.classList.add("esta-arrastando");
    });

    trilha.addEventListener("pointermove", (e) => {
      if (!arrastando) return;
      const d = e.clientX - partiuEm;
      andou = Math.abs(d);
      if (andou > LIMIAR) {
        // só captura o ponteiro depois do limiar, senão um clique simples no link
        // seria engolido pelo arrasto
        trilha.setPointerCapture(e.pointerId);
        e.preventDefault();
      }
      trilha.scrollLeft = rolagemInicial - d;
    });

    const soltar = (e: PointerEvent) => {
      if (!arrastando) return;
      arrastando = false;
      trilha.classList.remove("esta-arrastando");
      trilha.style.scrollSnapType = "";
      if (trilha.hasPointerCapture?.(e.pointerId)) trilha.releasePointerCapture(e.pointerId);
      if (andou > LIMIAR) irPara(indiceAtual());
    };
    trilha.addEventListener("pointerup", soltar);
    trilha.addEventListener("pointercancel", soltar);

    // Depois de um arrasto de verdade, engole o clique que o navegador dispara em
    // seguida — senão soltar o mouse em cima de um cartão navegaria para o link dele.
    trilha.addEventListener(
      "click",
      (e) => {
        if (andou > LIMIAR) {
          e.preventDefault();
          e.stopPropagation();
          andou = 0;
        }
      },
      true,
    );
  });
</script>

<style>
  /* Estilo próprio, e não no prototype-*.css, porque esta peça não existe no HTML do designer:
     nasceu do site antigo. Assim ela funciona em qualquer página, independente de qual
     protótipo de CSS a página carrega. As cores vêm dos tokens, com o mesmo fallback que as
     outras folhas usam. */
  .depo { padding: 104px 0; background: var(--bg-primary, #fff); }
  .depo.alt { background: var(--bg-secondary, #FBF9F7); }

  /* CARROSSEL
     A rolagem é nativa: overflow-x + scroll-snap. Sai de graça o arrasto no celular, a
     inércia do sistema e a navegação por teclado; o JS só acrescenta os botões e a
     contagem falada.

     O padding-top de 50px não é estética: a foto de cada cartão é absoluta em top:-44px,
     ou seja, sobe para FORA do cartão. Num contêiner com overflow-x, o que sai da caixa é
     cortado — sem essa folga, as cinco fotos apareceriam decepadas ao meio. */
  .depo-trilha {
    list-style: none;
    margin: 56px 0 0;
    padding: 50px 0 4px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 52px) / 3);
    gap: 26px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* a barra de rolagem fica escondida: quem navega com mouse usa os botões, e no
       celular o gesto já é o modo natural. A área continua rolável. */
    scrollbar-width: none;
  }
  .depo-trilha::-webkit-scrollbar { display: none; }
  .depo-trilha > .depo-card { scroll-snap-align: start; }

  .depo-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* O topo generoso abre espaço para a foto, que sobe metade da própria altura. */
    padding: 62px 26px 30px;
    border: 1px solid var(--border-default, #DDD5CE);
    border-radius: var(--radius-lg, 16px);
    background: var(--bg-primary, #fff);
  }
  /* Um cartão por linha na cor da marca, como no site atual. É ritmo, não hierarquia:
     nenhum depoimento vale mais que outro. */
  .depo-card--marca {
    background: var(--action-primary, #F5380F);
    border-color: transparent;
  }

  .depo-foto {
    position: absolute;
    top: -44px;
    left: 50%;
    transform: translateX(-50%);
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--action-primary, #F5380F);
    background: var(--bg-primary, #fff);
  }
  .depo-card--marca .depo-foto { border-color: var(--bg-primary, #fff); }

  .depo-estrelas {
    font-size: 17px;
    letter-spacing: 3px;
    color: var(--action-primary, #F5380F);
    line-height: 1;
  }
  .depo-card--marca .depo-estrelas { color: #fff; }

  .depo-nome {
    margin: 12px 0 2px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -.01em;
    color: var(--text-primary, #2B2320);
  }
  .depo-cargo {
    margin: 0 0 16px;
    font-size: 13.5px;
    color: var(--text-secondary, #5B534E);
  }
  .depo-cargo strong { font-weight: 600; color: var(--text-primary, #2B2320); }

  .depo-frase { margin: 0; }
  /* <q> põe as aspas sozinho, pelo idioma da página — por isso elas não estão no texto. */
  .depo-frase q {
    font-size: 15px;
    line-height: 1.62;
    color: var(--text-secondary, #5B534E);
  }

  .depo-card--marca .depo-nome,
  .depo-card--marca .depo-cargo,
  .depo-card--marca .depo-cargo strong,
  .depo-card--marca .depo-frase q { color: #fff; }

  /* CONTROLES NAS LATERAIS
     O carrossel vira o bloco de referencia para posicionar os dois botoes, que ficam
     colados nas bordas, na altura do meio do cartao. */
  .depo-carrossel { position: relative; }

  .depo-nav {
    position: absolute;
    top: calc(50% + 25px);          /* +25 compensa o padding-top da trilha, que existe por causa da foto */
    transform: translateY(-50%);
    z-index: 2;
    /* 44px e o alvo minimo de toque confortavel no celular */
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-default, #DDD5CE);
    border-radius: 50%;
    background: var(--bg-primary, #fff);
    color: var(--text-primary, #2B2320);
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .09);
    transition: background .2s, color .2s, border-color .2s, transform .2s;
  }
  .depo-nav--ant  { left: -22px; }
  .depo-nav--prox { right: -22px; }

  .depo-nav:hover {
    background: var(--action-primary, #F5380F);
    border-color: transparent;
    color: #fff;
    transform: translateY(-50%) scale(1.06);
  }
  .depo-nav:focus-visible {
    outline: 2px solid var(--action-primary, #F5380F);
    outline-offset: 2px;
  }
  /* Nao ha botao desabilitado: o carrossel da a volta, entao sempre existe um proximo. */

  /* A contagem sai do desenho mas continua no documento, para leitor de tela. Nao usa
     display:none nem visibility:hidden: os dois tirariam o texto da leitura, que e
     justamente o que ele existe para fazer. */
  .depo-status {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Arrastar com o mouse: o cursor conta o que da para fazer, e durante o arrasto o texto
     nao pode ser selecionado, senao o gesto vira selecao de paragrafo. */
  .depo-trilha { cursor: grab; }
  .depo-trilha.esta-arrastando {
    cursor: grabbing;
    user-select: none;
    scroll-behavior: auto;
  }
  .depo-trilha.esta-arrastando .depo-card { pointer-events: none; }

  @media (max-width: 940px) {
    .depo-trilha { grid-auto-columns: calc((100% - 26px) / 2); }
  }
  /* BOTÕES ABAIXO DA TRILHA QUANDO NÃO HÁ GUTTER
     Medido: de 1180px para baixo o container perde a folga lateral e o botão, que é
     absoluto, deixa de ficar ao lado do carrossel e passa a ficar EM CIMA dele — 44px
     sobre o cartão e 21 a 27px sobre o texto da citação, tapando a primeira linha.
     Empurrar o botão para dentro (left:4px) não resolvia: só escolhia qual parte do
     depoimento seria coberta.
     Aqui eles saem do posicionamento absoluto e viram uma dupla centralizada abaixo da
     trilha. O grid é o que permite isso sem mexer na ordem do HTML, que precisa continuar
     sendo trilha → anterior → próximo para quem navega por teclado. */
  @media (max-width: 1180px) {
    .depo-carrossel {
      display: grid;
      grid-template-columns: 1fr auto auto 1fr;
      grid-template-areas:
        "trilha trilha trilha trilha"
        ".      ant    prox   .";
      column-gap: 12px;
      row-gap: 22px;
    }
    .depo-trilha    { grid-area: trilha; }
    .depo-nav--ant  { grid-area: ant; }
    .depo-nav--prox { grid-area: prox; }
    .depo-nav {
      position: static;
      transform: none;
      top: auto;
      left: auto;
      right: auto;
    }
    /* o hover herdava o translateY(-50%) do posicionamento absoluto, que aqui jogaria o
       botão meio corpo para cima ao passar o mouse */
    .depo-nav:hover { transform: scale(1.06); }
  }
  @media (max-width: 680px) {
    .depo { padding: 64px 0; }
    .depo-trilha {
      grid-auto-columns: 100%;
      margin-top: 44px;
    }
    .depo-card { padding: 58px 20px 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .depo-trilha { scroll-behavior: auto; }
  }
</style>
