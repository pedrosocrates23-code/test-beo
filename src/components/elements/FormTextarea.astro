---
// Elemento: Form/Textarea (Figma node 21:117)
export interface Props {
  label?: string;
  placeholder?: string;
  name?: string;
  id?: string;
  class?: string;
}
const {
  label = "Label",
  placeholder = "Mensagem...",
  name,
  id,
  class: className = "",
} = Astro.props;
---
<div class={`form-textarea ${className}`}>
  <label class="form-textarea__label" for={id}>{label}</label>
  <div class="form-textarea__box">
    <textarea class="form-textarea__field" id={id} name={name} placeholder={placeholder}></textarea>
  </div>
</div>

<style>
  .form-textarea {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
    width: 320px;
  }
  .form-textarea__label {
    width: 100%;
    font: 500 14px/normal var(--font-family-base);
    color: var(--text-primary);
  }
  .form-textarea__box {
    display: flex;
    align-items: flex-start;
    width: 100%;
    height: 100px;
    background: var(--bg-primary);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: var(--space-12) var(--space-16);
  }
  .form-textarea__field {
    flex: 1 0 0;
    min-width: 0;
    width: 100%;
    height: 100%;
    resize: none;
    border: none;
    outline: none;
    background: transparent;
    font: 400 14px/normal var(--font-family-base);
    color: var(--text-primary);
  }
  .form-textarea__field::placeholder {
    color: var(--text-placeholder);
  }
</style>
