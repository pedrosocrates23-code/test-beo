---
// Página: artigo do blog (/blog/<slug>/).
// Mesma moldura de /blog/exemplo/, mas alimentada pela content collection "artigos" —
// os 149 posts migrados do Framer. O exemplo continua no lugar como referência do designer.
//
// Imagem de destaque: sai do campo `hero`. Quando `hero` é null, a capa daquele artigo não
// passou no corte de qualidade (menos de 1200px de largura) e a página sobe SEM hero, em vez
// de esticar uma imagem pequena na largura da tela. A mesma capa segue servindo de card na
// listagem, onde o tamanho basta.
//
// Tempo de leitura: medido no corpo real de cada artigo com contarPalavras(), como manda o
// aviso em ArticleBody.astro — nunca digitado à mão, nunca herdado do exemplo.
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { contarPalavras, tempoDeLeitura, normalizarLinks, resumoDeCard } from "../../lib/artigo";
import Layout from "../../layouts/Layout.astro";
import "../../styles/prototype-artigo.css";
import Header from "../../components/elements/Header.astro";
import MobileMenu from "../../components/elements/MobileMenu.astro";
import ArticleHeader from "../../components/elements/ArticleHeader.astro";
import ArticleFeaturedImage from "../../components/elements/ArticleFeaturedImage.astro";
import ArticleBody from "../../components/elements/ArticleBody.astro";
import RelatedArticles from "../../components/elements/RelatedArticles.astro";
import Footer from "../../components/elements/Footer.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const artigos = await getCollection("artigos");

  // O campo `relacionados` do JSON guarda só slug, título, categoria e palavras — o
  // suficiente para a REGRA de escolha, não para desenhar o card. Capa e lead ficam no
  // artigo relacionado, não no que aponta para ele. A resolução acontece aqui, no build,
  // porque é o único lugar com a coleção inteira à mão: dentro do componente cada card
  // teria de abrir a coleção de novo, 300 vezes.
  const porSlug = new Map(artigos.map((e) => [e.data.slug, e.data]));

  return artigos.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      artigo: entry.data,
      relacionados: entry.data.relacionados.map((r) => {
        const alvo = porSlug.get(r.slug);
        return { ...r, lead: alvo?.lead ?? "", capa: alvo?.card ?? null };
      }),
    },
  }));
};

// Sem este tipo, Astro.props entra como `unknown` e todo acesso a artigo.* deixa de ser
// verificado: um campo renomeado no schema passaria batido no build e só apareceria na página.
interface Props {
  artigo: CollectionEntry<"artigos">["data"];
  /** Os dois relacionados, já com o lead e a capa buscados no artigo de destino. */
  relacionados: (CollectionEntry<"artigos">["data"]["relacionados"][number] & {
    lead: string;
    capa: string | null;
  })[];
}

const { artigo, relacionados: relacionadosCrus } = Astro.props as Props;

const minutos = tempoDeLeitura(
  contarPalavras(artigo.corpo) + contarPalavras(artigo.lead),
);

// Regra de target dos links do corpo: link da casa substitui a aba, link de fora abre outra.
// Vale para todo artigo, inclusive os que entrarem depois — ver normalizarLinks() em lib/artigo.
const corpo = normalizarLinks(artigo.corpo);

const relacionados = relacionadosCrus.map((r) => ({
  categoria: r.categoria,
  titulo: r.titulo,
  resumo: resumoDeCard(r.lead),
  meta: `${tempoDeLeitura(r.palavras)} min de leitura`,
  href: `/blog/${r.slug}/`,
  imagem: r.capa,
}));
---
<Layout
  title={artigo.metaTitle}
  description={artigo.metaDescription}
  schema={{
    tipo: "artigo",
    nome: artigo.metaTitle,
    descricao: artigo.metaDescription || artigo.lead,
    titulo: artigo.titulo,
    dataIso: artigo.dataIso,
    categoria: artigo.categoria,
    palavras: contarPalavras(artigo.corpo) + contarPalavras(artigo.lead),
    minutos,
    imagem: artigo.hero,
    migalhas: [
      { nome: "Home", url: "/" },
      { nome: "Blog", url: "/blog/" },
      { nome: artigo.titulo, url: `/blog/${artigo.slug}/` },
    ],
  }}
>
  <Header ativo="blog" tema="claro" />
  <MobileMenu />

  <article class="article">
    <ArticleHeader
      titulo={artigo.titulo}
      lead={artigo.lead}
      dataIso={artigo.dataIso}
      categoria={artigo.categoria}
      minutos={minutos}
      autor={artigo.autor}
      autorCargo="Conteúdo Beorange"
    />

    {artigo.hero && (
      <ArticleFeaturedImage src={artigo.hero} alt={artigo.imagemAlt} />
    )}

    <ArticleBody>
      <Fragment set:html={corpo} />
    </ArticleBody>

    {relacionados.length > 0 && <RelatedArticles artigos={relacionados} />}
  </article>

  <Footer />

  <script is:inline src="/js/site.js"></script>
</Layout>
