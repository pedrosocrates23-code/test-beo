  }}
  escopoTitulo="Escopo da atuação tributária"
  escopo={[
    {
      rotulo: "Análise e enquadramento",
      itens: [
        "Análise e acompanhamento do regime tributário",
        "Estratégias tributárias para empresas no Lucro Real",
        "Revisão das bases de IRPJ, CSLL, PIS e COFINS",
        "Análise tributária de novas operações, produtos e modelos de negócio",
      ],
    },
    {
      rotulo: "Créditos e recuperação",
      itens: [
        "Análise e aproveitamento de créditos tributários",
        "Identificação de recolhimentos indevidos ou realizados a maior",
        "Recuperação e compensação de créditos",
        "Retificação de obrigações acessórias",
      ],
    },
    {
      rotulo: "Revisão e conformidade",
      itens: [
        "Revisão de apurações e obrigações acessórias",
        "Diagnósticos fiscais e tributários",
        "Acompanhamento de fiscalizações, notificações e regularizações",
        "Preparação de relatórios técnicos para atuação conjunta com o jurídico",
      ],
    },
    {
      rotulo: "Estrutura e planejamento",
      itens: [
        "Planejamento tributário",
        "Apoio técnico em reorganizações societárias",
      ],
    },
  ]}
  atuacao={{
    titulo: "Sem tese pronta",
    texto: "A análise parte da contabilidade, dos documentos fiscais, dos contratos, da natureza das receitas, da cadeia de fornecedores e da estrutura operacional. No Lucro Real, isso significa olhar a formação do resultado tributável, a dedutibilidade das despesas, os créditos de PIS e COFINS e a consistência entre as obrigações entregues.",
    etapas: [
      "Diagnóstico da situação atual, com a documentação da própria empresa",
      "Identificação de inconsistências, riscos e valores recuperáveis",
      "Apresentação dos caminhos, com impacto estimado e o que cada um exige",
      "Execução do que for aprovado, com acompanhamento das obrigações",
    ],
    ressalva: "Estratégias tributárias dependem de diagnóstico prévio e não são apresentadas como resultado garantido. Projetos consultivos específicos, como recuperação de créditos, são contratados à parte da mensalidade. Quando a estratégia gera economia mensurável, a contratação pode incluir remuneração vinculada à economia efetivamente gerada.",
  }}
  beneficios={{
    itens: [
      "Redução de riscos fiscais e mais segurança nas apurações",
