---
// Página de solução: Contabilidade Beorange — Tributário.
// Esta é a única das 11 frentes que o documento de tom traz INTEIRA, como exemplo preenchido
// do modelo (PÁGINA 8). Por isso ela não é gerada a partir do documento de produtos como as
// outras dez: o texto abaixo é o daquele exemplo, dobra por dobra, sem reescrita — incluindo
// a dobra 2, que nas demais não existe.
//
// A ressalva da dobra 4 não é decorativa. O documento de produtos, na seção "Limites e
// cuidados de promessa", proíbe apresentar estratégia tributária como resultado garantido
// antes do diagnóstico e exige deixar claro que projeto consultivo é contratado à parte.
// Se alguém cortar essa ressalva por espaço, a página passa a prometer o que a empresa não
// vende.
import PaginaSolucao from "../../../components/elements/PaginaSolucao.astro";
---
<PaginaSolucao
  metaTitle="Tributário | Estratégia no Lucro Real e preparação para IBS e CBS"
  metaDescription="Revisão de bases, créditos, recuperação e planejamento tributário para empresas no Lucro Real, com preparação para a Reforma Tributária."
  produto="Contabilidade Beorange"
  produtoHref="/contabilidade-beorange/"
  frente="Tributário"
  titulo="Estratégia tributária construída a partir da sua operação"
  lead="Análise que parte da contabilidade, dos documentos fiscais e dos contratos da empresa. Atuação forte em Lucro Real e na preparação para o novo modelo de tributação sobre o consumo."
  ctaPrimario="Solicitar diagnóstico tributário"
  problema={{
    titulo: "No Lucro Real, o erro não aparece na guia. Aparece no caixa",
    texto: "A qualidade da escrituração, a formação das bases, a dedutibilidade das despesas e o aproveitamento de créditos de PIS e COFINS decidem quanto a empresa efetivamente paga. Quando fiscal, contábil e operação não conversam, a conta fecha sempre para o lado mais caro.",
    sinais: [
      "Nenhuma revisão de créditos foi feita nos últimos 12 meses",
      "Despesas relevantes sem análise de dedutibilidade",
      "Apurações que ninguém revisou depois de entregues",
      "Mudança de regime decidida na virada do ano, sem simulação",
    ],
